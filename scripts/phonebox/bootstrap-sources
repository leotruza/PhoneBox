#!/usr/bin/env bash
# Fetch the pinned source trees required by virtual-phone-x86_64.
# This script only prepares source workspaces; it does not build or test them.

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: bootstrap-sources [options]

Options:
  --root PATH       source workspace, default: $PHONEBOX_SOURCES or .phonebox-sources
  --jobs N          repo sync parallelism, default: 8
  --skip-gbl        do not initialize the GBL manifest workspace
  --skip-aosp       do not initialize the AOSP manifest workspace
  --help            show this help

The workspace is disposable until its generated source manifest is reviewed.
No build, test, or image-generation command is run by this script.
EOF
}

root=${PHONEBOX_SOURCES:-.phonebox-sources}
jobs=${PHONEBOX_SYNC_JOBS:-8}
skip_gbl=0
skip_aosp=0

while (($#)); do
    case $1 in
        --root) (($# >= 2)) || { echo 'error: --root requires a path' >&2; exit 2; }; root=$2; shift 2; continue ;;
        --jobs) (($# >= 2)) || { echo 'error: --jobs requires a number' >&2; exit 2; }; jobs=$2; shift 2; continue ;;
        --skip-gbl) skip_gbl=1 ;;
        --skip-aosp) skip_aosp=1 ;;
        -h|--help) usage >&1; exit 0 ;;
        *) echo "error: unknown argument: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

[[ $jobs =~ ^[0-9]+$ && $jobs -gt 0 ]] || { echo 'error: --jobs must be positive' >&2; exit 2; }
for tool in git; do
    command -v "$tool" >/dev/null 2>&1 || { echo "error: required tool not found: $tool" >&2; exit 127; }
done

mkdir -p "$root"
root=$(cd "$root" && pwd)

clone_at() {
    local url=$1 destination=$2 ref=$3
    if [[ -e $destination/.git ]]; then
        git -C "$destination" fetch --tags --force origin "$ref"
        git -C "$destination" checkout --detach "$ref"
    else
        git clone --filter=blob:none --no-checkout "$url" "$destination"
        git -C "$destination" fetch --tags --force origin "$ref"
        git -C "$destination" checkout --detach "$ref"
    fi
}

clone_at https://gitlab.com/qemu-project/qemu.git \
    "$root/qemu" v11.1.0

clone_at https://github.com/tianocore/edk2.git \
    "$root/edk2" d07d3f5a5769cc8c9f76385174b73ea85525077
if [[ -f "$root/edk2/.gitmodules" ]]; then
    git -C "$root/edk2" submodule update --init --recursive
fi

init_repo_workspace() {
    local destination=$1 manifest_url=$2 branch=$3 pinned_commit=$4
    command -v repo >/dev/null 2>&1 || {
        echo "error: repo is required for $destination; install Android repo first" >&2
        exit 127
    }
    mkdir -p "$destination"
    if [[ ! -d "$destination/.repo" ]]; then
        repo init -u "$manifest_url" -b "$branch" --partial-clone --no-use-superproject \
            --repo-url=https://android.googlesource.com/tools/repo
    fi
    git -C "$destination/.repo/manifests" fetch origin "$pinned_commit"
    git -C "$destination/.repo/manifests" checkout --detach "$pinned_commit"
    repo sync -c --force-sync --no-clone-bundle --no-tags -j"$jobs"
    cat > "$destination/.phonebox-source-pin" <<EOF
manifest_url=$manifest_url
manifest_branch=$branch
manifest_review_commit=$pinned_commit
sync_jobs=$jobs
EOF
}

if ((skip_gbl == 0)); then
    (
        cd "$root/gbl"
        init_repo_workspace "$PWD" \
            https://android.googlesource.com/kernel/manifest \
            uefi-gbl-mainline \
            fbf316d03a5312c3d58699332a0e3a9ffe955c4c
    )
fi

if ((skip_aosp == 0)); then
    (
        cd "$root/aosp"
        init_repo_workspace "$PWD" \
            https://android.googlesource.com/platform/manifest \
            android17-release \
            29ace668ae756c7b8917c57abb440f6518844b0c
    )
fi

cat > "$root/source-workspace.toml" <<EOF
# Generated by scripts/phonebox/bootstrap-sources.
# This records intent and sync inputs; inspect .phonebox-source-pin files before building.
[qemu]
path = "$root/qemu"
ref = "v11.1.0"
[ovmf]
path = "$root/edk2"
ref = "d07d3f5a5769cc8c9f76385174b73ea85525077"
[gbl]
path = "$root/gbl"
manifest_branch = "uefi-gbl-mainline"
manifest_commit = "fbf316d03a5312c3d58699332a0e3a9ffe955c4c"
[android]
path = "$root/aosp"
manifest_branch = "android17-release"
manifest_commit = "29ace668ae756c7b8917c57abb440f6518844b0c"
EOF

printf 'Prepared source workspace: %s\n' "$root"
printf 'Workspace manifest: %s/source-workspace.toml\n' "$root"
