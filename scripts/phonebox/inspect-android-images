#!/usr/bin/env bash
# Inspect a built Android product and emit an image-contract report.
# This tool is intentionally execution-only when called by a maintainer; it
# does not modify Android artifacts and is not run by the implementation task.

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: inspect-android-images --product-dir DIR --output REPORT [options]

Required:
  --product-dir DIR   AOSP out/target/product/emu64x directory
  --output REPORT     Markdown report path

Optional:
  --unpack-bootimg PATH  unpack_bootimg executable
  --lpdump PATH          lpdump executable
  --avbtool PATH         avbtool executable
  --help                 show this help

The report records hashes, sizes, image presence, boot-image metadata,
logical-partition metadata, and AVB descriptors when the tools are available.
Missing tools are recorded as unavailable rather than hidden.
EOF
}

product_dir=
output=
unpack_bootimg=${PHONEBOX_UNPACK_BOOTIMG:-unpack_bootimg}
lpdump=${PHONEBOX_LPDUMP:-lpdump}
avbtool=${PHONEBOX_AVBTOOL:-avbtool}

while (($#)); do
    case $1 in
        --product-dir) (($# >= 2)) || { echo 'error: --product-dir requires a path' >&2; exit 2; }; product_dir=$2; shift 2; continue ;;
        --output) (($# >= 2)) || { echo 'error: --output requires a path' >&2; exit 2; }; output=$2; shift 2; continue ;;
        --unpack-bootimg) unpack_bootimg=$2; shift 2; continue ;;
        --lpdump) lpdump=$2; shift 2; continue ;;
        --avbtool) avbtool=$2; shift 2; continue ;;
        -h|--help) usage >&1; exit 0 ;;
        *) echo "error: unknown argument: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

[[ -n $product_dir && -n $output ]] || { echo 'error: --product-dir and --output are required' >&2; usage; exit 2; }
[[ -d $product_dir ]] || { echo "error: product directory not found: $product_dir" >&2; exit 2; }
mkdir -p "$(dirname -- "$output")"

have() { command -v "$1" >/dev/null 2>&1; }
report_path=$(cd "$product_dir" && pwd)
{
    printf '# Android image contract report\n\n'
    printf -- '- Product directory: `%s`\n' "$report_path"
    printf -- '- Product: `sdk_phone64_x86_64-userdebug` / `emu64x`\n'
    printf -- '- Generated by: `scripts/phonebox/inspect-android-images`\n\n'
    printf '## Image inventory\n\n| Name | Bytes | SHA-256 |\n|---|---:|---|\n'
    for image in boot.img vendor_boot.img init_boot.img dtbo.img vbmeta.img recovery.img super.img userdata.img; do
        path="$product_dir/$image"
        if [[ -f $path ]]; then
            bytes=$(stat -c '%s' "$path")
            digest=$(sha256sum "$path" | awk '{print $1}')
            printf '| `%s` | %s | `%s` |\n' "$image" "$bytes" "$digest"
        else
            printf '| `%s` | — | absent |\n' "$image"
        fi
    done

    printf '\n## Boot-image metadata\n\n'
    if have "$unpack_bootimg"; then
        for image in boot.img vendor_boot.img init_boot.img; do
            path="$product_dir/$image"
            [[ -f $path ]] || continue
            printf '### `%s`\n\n```text\n' "$image"
            "$unpack_bootimg" --boot_img "$path" 2>&1 || true
            printf '```\n\n'
        done
    else
        printf 'unpack_bootimg unavailable: `%s`\n\n' "$unpack_bootimg"
    fi

    printf '## Dynamic super metadata\n\n'
    if [[ -f "$product_dir/super.img" ]] && have "$lpdump"; then
        printf '```text\n'
        "$lpdump" "$product_dir/super.img" 2>&1 || true
        printf '```\n\n'
    else
        printf 'lpdump unavailable or super.img absent.\n\n'
    fi

    printf '## AVB metadata\n\n'
    if have "$avbtool"; then
        for image in boot.img vendor_boot.img init_boot.img dtbo.img vbmeta.img recovery.img; do
            path="$product_dir/$image"
            [[ -f $path ]] || continue
            printf '### `%s`\n\n```text\n' "$image"
            "$avbtool" info_image --image "$path" 2>&1 || true
            printf '```\n\n'
        done
    else
        printf 'avbtool unavailable: `%s`\n\n' "$avbtool"
    fi

    printf '## Build properties\n\n'
    for props in build.prop vendor/build.prop system/build.prop; do
        if [[ -f "$product_dir/$props" ]]; then
            printf '### `%s`\n\n' "$props"
            grep -E '^(ro\.build\.version\.sdk|ro\.product\.cpu\.abi|ro\.boot\.verifiedbootstate|ro\.hardware\.egl|ro\.hardware\.gralloc)=' "$product_dir/$props" || true
            printf '\n'
        fi
    done
} > "$output"

printf 'Image-contract report: %s\n' "$output"
